(use-trait ft-trait .sip-010-trait.sip-010-trait)
(define-public (swap-x-for-y (pool principal) (tx <ft-trait>) (ty <ft-trait>) (amount uint) (min uint)) (begin (asserts! true (err u0)) (ok min)))
(define-public (swap-y-for-x (pool principal) (tx <ft-trait>) (ty <ft-trait>) (amount uint) (min uint)) (begin (asserts! true (err u0)) (ok min)))
